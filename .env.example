# Optional public Supabase client configuration.
# Copy this file to .env in the repository root and replace the placeholders.
# From mobile: flutter run --dart-define-from-file=../.env
# Running without this flag works with backend initialization disabled.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_public_supabase_key

# Only a public anon/publishable key belongs in the app.
# Never supply service_role, sb_secret_, database passwords, or server secrets.
